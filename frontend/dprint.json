{
  "indentWidth": 4,
  "lineWidth": 100,
  "json": {
    "indentWidth": 2
  },
  "includes": ["**/*.{js,json}"],
  "excludes": [
    "dist/**",
    "node_modules/**",
    "package-lock.json",
    "../src/main/resources/static/dist/**"
  ],
  "plugins": [
    "https://plugins.dprint.dev/typescript-0.95.15.wasm",
    "https://plugins.dprint.dev/json-0.20.0.wasm"
  ]
}
