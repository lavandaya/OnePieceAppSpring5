### ═══════════════ Sign in as 'luffy' (owner of characters 1 and 3) ═══════════════

### Load the login page to obtain a CSRF token
GET {{baseUrl}}/login
Accept: text/html

> {%
    const token = response.headers.valuesOf("Set-Cookie")
        .filter(c => c.startsWith("XSRF-TOKEN="))
        .map(c => c.substring("XSRF-TOKEN=".length).split(";")[0])
        .filter(v => v.length > 0)
        .pop();
    client.global.set("csrfToken", token);
%}

### Sign in as luffy - Found
# @no-redirect
POST {{baseUrl}}/login
Content-Type: application/x-www-form-urlencoded

username=luffy&password=password123&_csrf={{csrfToken}}

> {%
    client.test("Login succeeded", () => {
        client.assert(response.status === 302, "Expected 302, got " + response.status);
    });
    const token = response.headers.valuesOf("Set-Cookie")
        .filter(c => c.startsWith("XSRF-TOKEN="))
        .map(c => c.substring("XSRF-TOKEN=".length).split(";")[0])
        .filter(v => v.length > 0)
        .pop();
    client.global.set("csrfToken", token);
%}


