### ═══════════════ Authorization failures ═══════════════

### Update a character owned by another user - Forbidden
PATCH {{baseUrl}}/api/characters/2
Content-Type: application/json
Accept: application/json
X-XSRF-TOKEN: {{csrfToken}}

{
  "power": 1.0
}

### Delete a character owned by another user - Forbidden
DELETE {{baseUrl}}/api/characters/2
Accept: application/json
X-XSRF-TOKEN: {{csrfToken}}

### Create character without a CSRF token - Forbidden
POST {{baseUrl}}/api/characters
Content-Type: application/json
Accept: application/json

{
  "name": "Jinbe",
  "age": 44,
  "appearance": "https://placehold.co/400x400/1d3f6e/ffffff?text=Jinbe",
  "powertype": "NO_POWER",
  "power": 8.0,
  "crewName": "Straw Hat Pirates"
}


### ═══════════════ Delete as owner ═══════════════

### Delete own character - No Content
DELETE {{baseUrl}}/api/characters/7
Accept: application/json
X-XSRF-TOKEN: {{csrfToken}}

### Get the deleted character - Not Found
GET {{baseUrl}}/api/characters/7
Accept: application/json


### ═══════════════ Sign in as 'admin' ═══════════════

### Sign out - Found
# @no-redirect
POST {{baseUrl}}/logout
Content-Type: application/x-www-form-urlencoded

_csrf={{csrfToken}}

### Load the login page again to obtain a fresh CSRF token
GET {{baseUrl}}/login
Accept: text/html

> {%
    const token = response.headers.valuesOf("Set-Cookie")
        .filter(c => c.startsWith("XSRF-TOKEN="))
        .map(c => c.substring("XSRF-TOKEN=".length).split(";")[0])
        .filter(v => v.length > 0)
        .pop();
    client.global.set("csrfToken", token);
%}

### Sign in as admin - Found
# @no-redirect
POST {{baseUrl}}/login
Content-Type: application/x-www-form-urlencoded

username=admin&password=admin123&_csrf={{csrfToken}}

> {%
    client.test("Login succeeded", () => {
        client.assert(response.status === 302, "Expected 302, got " + response.status);
    });
    const token = response.headers.valuesOf("Set-Cookie")
        .filter(c => c.startsWith("XSRF-TOKEN="))
        .map(c => c.substring("XSRF-TOKEN=".length).split(";")[0])
        .filter(v => v.length > 0)
        .pop();
    client.global.set("csrfToken", token);
%}


